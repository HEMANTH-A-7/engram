# Memory-layer configuration. Copy to `.env` and adjust.
# Uses Cognee's canonical env-var names (litellm-style) so Cognee and our own
# code share ONE config. Defaults are a fully-offline Ollama setup: zero cloud
# credentials required.

# --- LLM (Cognee extraction; also our router's default/"small" path) ---
LLM_PROVIDER=ollama
LLM_MODEL=ollama/llama3.2:3b
LLM_ENDPOINT=http://localhost:11434
LLM_API_KEY=ollama            # dummy; Cognee requires the trio to be non-empty for ollama

# --- Embeddings (Cognee vector store) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_ENDPOINT=http://localhost:11434
EMBEDDING_DIMENSIONS=768

# --- memory-layer extras: cost-aware router (Bucket 5) ---
# Small = routine extraction; Large = ambiguous conflict resolution / summaries.
MEMORY_MODEL_SMALL=ollama/llama3.2:3b
MEMORY_MODEL_LARGE=ollama/gemma4:latest
