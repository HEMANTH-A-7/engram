# Memory-layer configuration. Copy to `.env` and adjust.
# Uses Cognee's canonical env-var names (litellm-style) so Cognee and our own
# code share ONE config. Defaults are a fully-offline Ollama setup: zero cloud
# credentials required.

# --- LLM (Cognee extraction) ---
# NOTE: 3B models (e.g. llama3.2:3b) fail structured graph extraction — they echo
# the JSON *schema* instead of an instance. gemma4 handles instructor json_mode
# reliably, so it's the baseline extraction model. (Router tradeoff -> Bucket 5.)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:latest
# Cognee's Ollama instructor adapter uses an OpenAI client -> needs the /v1 path.
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama            # dummy; Cognee requires the trio to be non-empty for ollama
# Small nonzero temp so instructor's retries VARY — local models sometimes emit
# null for a required field at temp 0, and identical retries never recover.
LLM_TEMPERATURE=0.3

# --- Local no-auth posture (spec: no auth, single local process) ---
ENABLE_BACKEND_ACCESS_CONTROL=false
# Skip Cognee's 30s LLM pre-flight (local Ollama can cold-start slower than that).
COGNEE_SKIP_CONNECTION_TEST=true

# --- Embeddings (Cognee vector store) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Cognee's Ollama embedding engine posts to the native /api/embed path.
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_DIMENSIONS=768
# Cognee needs a HF tokenizer to chunk/count tokens for the Ollama embedder.
# nomic-embed-text uses the BERT tokenizer (small, ungated, cached after first run).
HUGGINGFACE_TOKENIZER=bert-base-uncased

# --- memory-layer extras: cost-aware router (Bucket 5) ---
# Small = routine extraction; Large = ambiguous conflict resolution / summaries.
MEMORY_MODEL_SMALL=llama3.2:3b
MEMORY_MODEL_LARGE=gemma4:latest
